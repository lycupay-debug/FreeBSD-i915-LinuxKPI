diff --git a/sys/compat/linuxkpi/common/src/linux_page.c b/sys/compat/linuxkpi/common/src/linux_page.c
--- a/sys/compat/linuxkpi/common/src/linux_page.c
+++ b/sys/compat/linuxkpi/common/src/linux_page.c
@@ -644,6 +644,71 @@
 	return (0);
 }
 
+/*
+ * Insert a Linux-style special PTE for a device PFN.
+ *
+ * Unlike lkpi_vmf_insert_pfn_prot_locked(), this path must not translate the
+ * PFN through PHYS_TO_VM_PAGE().  The PFN can identify an I/O aperture and
+ * need not have a managed vm_page in the system's physical-page array.
+ *
+ * FreeBSD's managed device pager requires a vm_page entry in its backing
+ * object.  Use a separately allocated fictitious page as that bookkeeping
+ * entry.  Its phys_addr carries the requested PFN, while the special mapping
+ * deliberately has no PV tracking for the target physical page.
+ *
+ * The caller must ensure that the user mappings are removed before the
+ * underlying physical resource is reused.
+ */
+vm_fault_t
+lkpi_vmf_insert_special_pte_locked(struct vm_area_struct *vma,
+    unsigned long addr, unsigned long pfn, pgprot_t prot)
+{
+	struct pctrie_iter pages;
+	vm_object_t vm_obj;
+	vm_page_t fake_page, page;
+	vm_pindex_t pindex;
+
+	if (addr < vma->vm_start || addr >= vma->vm_end)
+		return (VM_FAULT_SIGBUS);
+
+	vm_obj = vma->vm_obj;
+	VM_OBJECT_ASSERT_WLOCKED(vm_obj);
+	MPASS(vm_obj->type == OBJT_MGTDEVICE);
+
+	vm_page_iter_init(&pages, vm_obj);
+	pindex = OFF_TO_IDX(addr - vma->vm_start);
+	if (vma->vm_pfn_count == 0)
+		vma->vm_pfn_first = pindex;
+
+	page = vm_page_grab_iter(vm_obj, pindex, VM_ALLOC_NOCREAT, &pages);
+	if (page == NULL) {
+		fake_page = vm_page_getfake_nowait(IDX_TO_OFF(pfn),
+		    pgprot2cachemode(prot));
+		if (fake_page == NULL)
+			return (VM_FAULT_OOM);
+
+		fake_page->oflags |= VPO_FAKE_OWNED;
+		if (vm_page_iter_insert(fake_page, vm_obj, pindex, &pages) != 0) {
+			vm_page_putfake(fake_page);
+			return (VM_FAULT_OOM);
+		}
+		vm_page_valid(fake_page);
+		/*
+		 * Keep the page exclusively busy.  The managed-device pager
+		 * populate callback must return with every populated page busy.
+		 */
+	} else {
+		/*
+		 * The first insertion at this object index wins.  As with the
+		 * upstream prototype, do not replace an already resident page.
+		 */
+		pmap_page_set_memattr(page, pgprot2cachemode(prot));
+	}
+
+	vma->vm_pfn_count++;
+	return (VM_FAULT_NOPAGE);
+}
+
 int
 lkpi_io_mapping_map_user(struct io_mapping *iomap,
     struct vm_area_struct *vma, unsigned long addr,
diff --git a/sys/vm/device_pager.c b/sys/vm/device_pager.c
--- a/sys/vm/device_pager.c
+++ b/sys/vm/device_pager.c
@@ -293,6 +293,17 @@
 {
 	pmap_remove_all(m);
 	vm_page_iter_remove(pages, m);
+	if ((m->oflags & VPO_FAKE_OWNED) != 0) {
+		MPASS((m->flags & PG_FICTITIOUS) != 0);
+		/*
+		 * vm_page_iter_remove() drops the object's reference and releases
+		 * the page's busy lock.  Reacquire it before vm_page_putfake(),
+		 * which requires exclusive busy ownership.
+		 */
+		if (!vm_page_tryxbusy(m))
+			panic("%s: cannot reacquire fake page %p", __func__, m);
+		vm_page_putfake(m);
+	}
 }
 
